# 数据目录（DB + workspaces）。不设置时默认 <仓库根>/.agenthub-data
# E2E 靠这个变量做隔离
AGENTHUB_DATA_DIR=

# 前端来源（CORS）。默认 http://localhost:3000,http://127.0.0.1:3000
AGENTHUB_CORS_ORIGINS=

# API Keys for AI providers —— P3 起才用到
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# 火山方舟 (Volcano Ark) — 走豆包多模态模型用这个
ARK_API_KEY=

# Optional: override default Orchestrator model
# ORCHESTRATOR_PROVIDER=anthropic
# ORCHESTRATOR_MODEL_ID=claude-opus-4-7
